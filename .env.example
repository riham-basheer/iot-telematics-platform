# ===========================================================
# IoT Fleet Telematics Lakehouse — Environment Configuration 
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:   cp .env.example .env
# 2. Fill in with all your API keys below
# 3. Run ./bootstrap_pipeline.sh to automatically configure AIRFLOW_UID and start.


# 1. Host User Permissions (Linux / WSL)
# --------------------------------------
# Matches container file ownership with your local Linux user ID (run `id -u` to check).
# Note that bootstrap_pipeline.sh woll update this value automatically.
AIRFLOW_UID=1000


# 2. External Data API Keys
# ----------------------------
# NREL Alternative Fuel Data Center API Key (Free signup: https://developer.nrel.gov/signup/)
# Used by db/fetch_nrel_stations.py to fetch Ann Arbor EV charging stations
NREL_API_KEY=

# U.S. Energy Information Administration API Key (Free signup: https://www.eia.gov/opendata/)
# Used by db/seed_pricing_history.py to fetch weekly Michigan retail gasoline tariffs.
EIA_API_KEY=


# 3. PostgreSQL Data Warehouse Connection (Default Docker Compose Credentials)
# ------------------------------------------------------------------------------
# Leave these as default unless you changed them in docker-compose.yml
# Note: Inside Docker containers, DB_HOST automatically routes to 'postgres'
DB_USER=airflow
DB_PASSWORD=airflow
DB_NAME=telematics_dwh
DB_HOST=localhost
DB_PORT=5432
